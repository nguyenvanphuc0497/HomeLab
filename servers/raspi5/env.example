# Copy to .env (gitignored) and adjust; example values only
HOSTNAME=raspi5
TZ=Asia/Ho_Chi_Minh
DOMAIN_SUFFIX=.lan
DATA_ROOT=/srv/homelab/raspi5
PUID=1000
PGID=1000
UMASK=002
AMD_OMV_IP=192.x.x.x
NODE_OMV_IP=192.x.x.x
NODE_INTEL_IP=192.x.x.x

# WG-Easy VPN Configuration
# Your public IP or domain name (REQUIRED for VPN to work)
WG_HOST=vpn.yourdomain.com
# Web UI admin password (CHANGE THIS!)
WG_ADMIN_PASSWORD=changeme
# DNS server for VPN clients (optional, default: 1.1.1.1)
WG_DEFAULT_DNS=1.1.1.1
